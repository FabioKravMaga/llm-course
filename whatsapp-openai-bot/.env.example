# ── OpenAI ──────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ASSISTANT_ID=asst_...
ASSISTANT_MODEL=gpt-4o-mini

# ── Evolution API (Docker) ──────────────────────────────────────────
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=change-me-strong-key
EVOLUTION_INSTANCE=whatsapp-bot

# ── This bot ────────────────────────────────────────────────────────
PORT=3000
WEBHOOK_TOKEN=change-me-webhook-secret
DB_PATH=./data/threads.db
RUN_TIMEOUT_MS=90000
LOG_LEVEL=info
CONTRACTS_DIR=./data/contracts

# ── Follow-up scheduler ─────────────────────────────────────────────
# Enable/disable + scan interval. Delays are comma-separated ms,
# one per attempt. After the last attempt the lead is marked as lost.
FOLLOWUP_ENABLED=true
FOLLOWUP_SCAN_INTERVAL_MS=300000
# Default: 4h, 24h, 72h
FOLLOWUP_DELAYS_MS=14400000,86400000,259200000

# ── Lawyer / Office data (used inside the contract PDF) ─────────────
LAWYER_NAME=Fabio Krav Maga Advocacia
LAWYER_OAB=
LAWYER_DOCUMENT=
LAWYER_ADDRESS=
LAWYER_EMAIL=fabioadvogado@gmail.com
LAWYER_PIX_KEY=

# ── Digital signature (mock | zapsign) ──────────────────────────────
SIGNATURE_PROVIDER=mock
ZAPSIGN_TOKEN=
ZAPSIGN_WEBHOOK_SECRET=
PUBLIC_BASE_URL=
