# ── Anthropic Claude ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Modelo do Claude. Padrões úteis:
#   claude-opus-4-8     (mais capaz — recomendado)
#   claude-sonnet-4-6   (mais barato, ainda muito bom)
#   claude-haiku-4-5    (mais barato e rápido, para volumes altos)
CLAUDE_MODEL=claude-opus-4-8
# "adaptive" (recomendado), "disabled" para chat curto
CLAUDE_THINKING=adaptive
# Máx. de tokens por resposta do Claude (WhatsApp = mensagens curtas)
CLAUDE_MAX_TOKENS=2048

# ── Evolution API (Docker) ──────────────────────────────────────────
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=change-me-strong-key
EVOLUTION_INSTANCE=whatsapp-bot

# ── This bot ────────────────────────────────────────────────────────
PORT=3000
WEBHOOK_TOKEN=change-me-webhook-secret
DB_PATH=./data/threads.db
LOG_LEVEL=info
CONTRACTS_DIR=./data/contracts

# ── Follow-up scheduler ─────────────────────────────────────────────
FOLLOWUP_ENABLED=true
FOLLOWUP_SCAN_INTERVAL_MS=300000
# 4h, 24h, 72h. Depois marca como lost.
FOLLOWUP_DELAYS_MS=14400000,86400000,259200000

# ── Lawyer / Office data (entra no PDF do contrato) ─────────────────
LAWYER_NAME=Fabio Krav Maga Advocacia
LAWYER_OAB=
LAWYER_DOCUMENT=
LAWYER_ADDRESS=
LAWYER_EMAIL=fabioadvogado@gmail.com
LAWYER_PIX_KEY=

# ── Assinatura digital (mock | zapsign) ─────────────────────────────
SIGNATURE_PROVIDER=mock
ZAPSIGN_TOKEN=
ZAPSIGN_WEBHOOK_SECRET=
PUBLIC_BASE_URL=
